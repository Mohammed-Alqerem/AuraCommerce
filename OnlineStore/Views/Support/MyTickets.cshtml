@model List<SupportTicket>
@{ ViewData["Title"]="My Support Requests"; }
<section class="page-header"><div class="container"><span class="eyebrow">Support history</span><h1 class="display-title mt-2 mb-0">My support requests</h1></div></section><section class="page-section"><div class="container" style="max-width:900px"><div class="toolbar mb-4"><p class="muted mb-0">@Model.Count requests</p><a class="btn btn-accent" asp-action="Index">New request</a></div>@foreach(var ticket in Model){<article class="panel mb-3"><div class="toolbar"><div><span class="eyebrow">Request #@ticket.Id</span><h2 class="h5 mt-2">@ticket.Subject</h2><p class="muted mb-0">@ticket.Message</p></div><span class="status-badge">@ticket.Status</span></div><small class="muted">@ticket.CreatedAt.ToLocalTime().ToString("g")</small></article>}</div></section>
