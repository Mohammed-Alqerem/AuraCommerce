@{ ViewData["Title"]="FAQ"; }
<section class="page-header"><div class="container"><span class="eyebrow">Quick answers</span><h1 class="display-title mt-2 mb-0">Frequently asked questions</h1></div></section><section class="page-section"><div class="container" style="max-width:900px"><div class="panel"><h2 class="h5">How do I track an order?</h2><p class="muted">Open My Orders and select Details to see the latest store status and complete timeline.</p><h2 class="h5 mt-4">Can I change my delivery address?</h2><p class="muted">Update your profile for future orders. Completed orders retain the delivery address submitted at checkout.</p><h2 class="h5 mt-4">How do I contact support?</h2><p class="muted mb-0">Use the contact form and include your order number when your question is about a purchase.</p></div></div></section>
