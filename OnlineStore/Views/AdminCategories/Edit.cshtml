@model CategoryFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add Category" : "Edit Category"; }
<section class="page-section admin-form-page"><div class="container" style="max-width:760px"><div class="panel"><h1 class="section-title mb-4">@ViewData["Title"]</h1><form asp-action="Edit" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" method="post" novalidate><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label fw-bold"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label fw-bold"></label><textarea asp-for="Description" class="form-control" rows="4" style="resize:none"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Active</label></div><button class="btn btn-accent" type="submit">Save category</button><a class="btn btn-outline-dark ms-2" asp-action="Index">Cancel</a></form></div></div></section>
