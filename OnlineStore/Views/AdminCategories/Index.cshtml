@model List<Categories>
@{ ViewData["Title"] = "Admin Categories"; }
<section class="page-header"><div class="container">@await Html.PartialAsync("_AdminNavigation")<div class="admin-heading"><div><span class="eyebrow">Catalog structure</span><h1 class="display-title mt-2 mb-2">Categories</h1><p class="muted mb-0">Organize products without deleting historical data.</p></div><a class="btn btn-accent" asp-action="Edit">Add category</a></div></div></section>
<section class="page-section"><div class="container"><div class="panel table-responsive"><table class="table table-store"><thead><tr><th>Name</th><th>Description</th><th>Products</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var category in Model){<tr><td><strong>@category.Name</strong></td><td>@category.Description</td><td>@category.Products.Count</td><td>@(category.IsActive ? "Active" : "Archived")</td><td><div class="d-flex gap-2"><a class="btn btn-outline-dark py-1" asp-action="Edit" asp-route-id="@category.Id">Edit</a><form asp-action="Toggle" asp-route-id="@category.Id" method="post"><button class="btn @(category.IsActive ? "btn-outline-danger" : "btn-outline-success") py-1" type="submit">@(category.IsActive ? "Archive" : "Restore")</button></form></div></td></tr>}</tbody></table></div></div></section>
