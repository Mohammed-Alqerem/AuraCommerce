@model List<SupportTicket>
@{ ViewData["Title"]="Support Requests"; }
<section class="page-header"><div class="container admin-page-header"><div class="admin-heading"><div><span class="eyebrow">Customer care</span><h1 class="display-title mt-2 mb-0">Support requests</h1></div></div><partial name="_AdminNavigation" /></div></section><section class="page-section"><div class="container"><div class="panel table-responsive"><table class="table table-store"><thead><tr><th>Date</th><th>Customer</th><th>Subject</th><th>Message</th><th>Status</th></tr></thead><tbody>@foreach(var ticket in Model){<tr><td>@ticket.CreatedAt.ToLocalTime().ToString("g")</td><td><strong>@ticket.Name</strong><div class="muted small">@ticket.Email</div></td><td>@ticket.Subject</td><td>@ticket.Message</td><td><form asp-action="Status" asp-route-id="@ticket.Id" method="post" class="d-flex gap-2"><select class="form-select" name="status"><option selected="@(ticket.Status=="Open")">Open</option><option selected="@(ticket.Status=="Resolved")">Resolved</option></select><button class="btn btn-outline-dark" type="submit">Save</button></form></td></tr>}</tbody></table></div></div></section>
