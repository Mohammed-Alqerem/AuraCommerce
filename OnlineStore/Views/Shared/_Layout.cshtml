@inject OnlineStore.Data.ApplicationDbContext DbContext
@{
    var currentUserId = Context.Session.GetInt32("UserId");
    var currentUserName = Context.Session.GetString("UserName");
    var isLoggedIn = currentUserId.HasValue;
    var isAdmin = currentUserId == 1;
    var isCustomer = isLoggedIn && !isAdmin;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var cartItemCount = 0;

    if (isCustomer)
    {
        cartItemCount = DbContext.CartItems
            .Where(item => item.Cart!.UserId == currentUserId!.Value)
            .Select(item => (int?)item.Quantity)
            .Sum() ?? 0;
    }

    var toastMessage = TempData["CartMessage"] as string ?? TempData["AdminMessage"] as string;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aura Commerce</title>
    <meta name="description" content="Aura Commerce offers a curated selection of everyday products with secure checkout and responsive service." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Kufi+Arabic:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineStore.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index" data-i18n="brand">Aura Commerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" data-i18n="nav.home">Home</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index" data-i18n="nav.products">Products</a></li>
                        @if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index" data-i18n="nav.orders">Orders</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link admin-nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index" data-i18n="nav.adminPortal">Admin Portal</a></li>
                        }
                    </ul>
                    <form class="nav-search" asp-controller="Products" asp-action="Index" method="get">
                        <span class="material-symbols-outlined">search</span>
                        <input name="searchTerm" type="search" placeholder="Search products" value="@Context.Request.Query["searchTerm"]" data-i18n-placeholder="search.placeholder" />
                    </form>
                    <div class="nav-actions">
                        <button class="icon-button js-theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
                            <span class="material-symbols-outlined">dark_mode</span>
                        </button>
                        <button class="language-button js-language-toggle" type="button" aria-label="Switch language">AR</button>
                        @if (isCustomer)
                        {
                            <a class="icon-button cart-button" asp-controller="Cart" asp-action="Index" aria-label="Cart, @cartItemCount items" data-cart-count="@cartItemCount">
                                <span class="material-symbols-outlined">shopping_cart</span>
                                @if (cartItemCount > 0)
                                {
                                    <span class="cart-count" aria-hidden="true">@cartItemCount</span>
                                }
                            </a>
                            <a class="account-chip" asp-controller="Account" asp-action="Profile" aria-label="Profile" data-i18n-aria-label="nav.profile">
                                <span class="material-symbols-outlined">account_circle</span>
                                <span>@currentUserName</span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-dark nav-login" type="submit" data-i18n="nav.logout">Logout</button>
                            </form>
                        }
                        else if (isAdmin)
                        {
                            <a class="admin-portal-chip" asp-controller="Admin" asp-action="Index">
                                <span class="material-symbols-outlined">admin_panel_settings</span>
                                <span data-i18n="nav.adminPortal">Admin Portal</span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-dark nav-login" type="submit" data-i18n="nav.logout">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-dark nav-login" asp-controller="Account" asp-action="Register" data-i18n="footer.register">Register</a>
                            <a class="btn btn-accent nav-login" asp-controller="Account" asp-action="Login" data-i18n="nav.login">Login</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    @if (toastMessage is not null)
    {
        <div class="store-toast" role="status" aria-live="polite">
            <span class="material-symbols-outlined">shopping_bag</span>
            <span>@toastMessage</span>
        </div>
    }

    <footer class="site-footer" role="contentinfo">
        <div class="container footer-grid">
            <div>
                <a class="footer-brand" asp-controller="Home" asp-action="Index" data-i18n="brand">Aura Commerce</a>
                <p data-i18n="footer.summary">Premium everyday products powered by a clean MVC store platform.</p>
            </div>
            <div>
                <h2 data-i18n="footer.shop">Shop</h2>
                <a asp-controller="Products" asp-action="Index" data-i18n="footer.allProducts">All products</a>
                @if (isCustomer)
                {
                    <a asp-controller="Cart" asp-action="Index" data-i18n="footer.cart">Cart</a>
                    <a asp-controller="Checkout" asp-action="Index" data-i18n="footer.checkout">Checkout</a>
                }
            </div>
            <div>
                <h2 data-i18n="footer.account">Account</h2>
                @if (isCustomer)
                {
                    <a asp-controller="Account" asp-action="Profile" data-i18n="nav.profile">Profile</a>
                }
                else if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Index" data-i18n="nav.adminPortal">Admin Portal</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" data-i18n="nav.login">Login</a>
                    <a asp-controller="Account" asp-action="Register" data-i18n="footer.register">Register</a>
                }
            </div>
            <div>
                <h2 data-i18n="footer.operations">Operations</h2>
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Products" data-i18n="nav.products">Products</a>
                    <a asp-controller="Admin" asp-action="Orders" data-i18n="nav.orders">Orders</a>
                    <a asp-controller="Admin" asp-action="Users" data-i18n="footer.users">Users</a>
                }
                else
                {
                    <a asp-controller="Products" asp-action="Index" data-i18n="footer.allProducts">All products</a>
                }
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true"></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" asp-append-version="true"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    <script type="module" src="~/js/commerce-scene.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
