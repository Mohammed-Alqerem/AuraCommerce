@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-section recovery-page">
    <div class="container">
        <div class="empty-state recovery-card mx-auto" style="max-width: 680px;" role="alert">
            <div class="recovery-icon"><span class="material-symbols-outlined">error</span></div>
            <h1 class="section-title mt-3">Something went wrong</h1>
            <p class="muted">We could not complete that request. Please return to the storefront and try again.</p>
            <a class="btn btn-accent" asp-controller="Home" asp-action="Index">Return home</a>
            @if (Model.ShowRequestId)
            {
                <p class="muted small mt-4 mb-0">Support reference: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</section>
