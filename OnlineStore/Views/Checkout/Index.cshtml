@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">Checkout</span>
        <h1 class="display-title mt-2 mb-0">Complete Your Order</h1>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <form asp-action="Index" method="post" class="row g-4">
            @Html.AntiForgeryToken()
            <div class="col-lg-7">
                <div class="panel">
                    <h2 class="h4 fw-bold mb-4">Shipping Details</h2>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-bold"></label>
                            <input asp-for="Address" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="panel">
                    <h2 class="h4 fw-bold mb-4">Review Order</h2>
                    @foreach (var item in Model.Cart.Items)
                    {
                        if (item.Product == null)
                        {
                            continue;
                        }

                        <div class="d-flex justify-content-between gap-3 mb-3">
                            <span>@item.Product.Name x @item.Quantity</span>
                            <strong>$@((item.Product.Price * item.Quantity).ToString("0.00"))</strong>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><strong>$@Model.Cart.Subtotal.ToString("0.00")</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>Shipping</span><strong>$@Model.Cart.Shipping.ToString("0.00")</strong></div>
                    <div class="d-flex justify-content-between mb-3"><span>Tax</span><strong>$@Model.Cart.Tax.ToString("0.00")</strong></div>
                    <div class="d-flex justify-content-between fs-4 mb-4"><span>Total</span><strong>$@Model.Cart.Total.ToString("0.00")</strong></div>
                    <button class="btn btn-accent w-100" type="submit">Place Order</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
