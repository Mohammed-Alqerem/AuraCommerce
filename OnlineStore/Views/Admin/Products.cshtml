@model List<Products>

@{
    ViewData["Title"] = "Admin Products";
}

<section class="page-header">
    <div class="container admin-heading">
        <div>
            <span class="eyebrow">Catalog management</span>
            <h1 class="display-title mt-2 mb-2">Products</h1>
            <p class="muted mb-0">Manage product information, pricing, and availability.</p>
        </div>
        <a class="btn btn-accent" asp-action="ProductForm"><span class="material-symbols-outlined">add</span>Add product</a>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <partial name="_AdminNavigation" />
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        <div class="panel admin-panel">
            <div class="admin-panel-bar"><span class="muted">@Model.Count products in catalog</span><a asp-action="ProductForm">Create product</a></div>
            <div class="table-responsive"><table class="table table-store align-middle admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock / status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td><strong>@product.Name</strong><div class="muted small text-truncate" style="max-width: 260px;">@product.Description</div></td>
                            <td>@product.Category?.Name</td>
                            <td><strong>$@product.Price.ToString("0.00")</strong></td>
                            <td>
                                <span class="stock-indicator @(product.Stock <= StoreSettings.LowStockThreshold ? "critical" : "")">@product.Stock in stock</span>
                                <span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">@(product.IsActive ? "Active" : "Archived")</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end">
                                    <a class="btn btn-outline-dark py-1" asp-action="ProductForm" asp-route-id="@product.Id">Edit</a>
                                    <form asp-action="DeleteProduct" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button class="btn @(product.IsActive ? "btn-outline-danger" : "btn-outline-success") py-1" type="submit">@(product.IsActive ? "Archive" : "Restore")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </div>
    </div>
</section>
