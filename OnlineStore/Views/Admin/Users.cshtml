@model List<Users>

@{
    ViewData["Title"] = "Admin Users";
}

<section class="page-header">
    <div class="container admin-heading">
        <div><span class="eyebrow">Customer directory</span><h1 class="display-title mt-2 mb-2">Customers</h1><p class="muted mb-0">Review account information and purchase activity.</p></div>
        <span class="admin-summary-pill">@Model.Count customers</span>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <partial name="_AdminNavigation" />
        <div class="panel admin-panel"><div class="table-responsive"><table class="table table-store align-middle admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><strong>@user.Name</strong></td>
                            <td><a href="mailto:@user.Email">@user.Email</a></td>
                            <td>@user.Phone</td>
                            <td>@user.Address</td>
                            <td><span class="customer-order-count">@(user.Orders?.Count ?? 0)</span></td>
                        </tr>
                    }
                </tbody>
            </table></div></div>
        </div>
    </div>
</section>
