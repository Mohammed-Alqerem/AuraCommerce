@model Orders
@{ ViewData["Title"]=$"Admin Order #{Model.Id}"; var statusClass=$"status-{Model.Status.ToLowerInvariant()}"; }
<section class="page-section"><div class="container"><a class="back-link" asp-action="Orders">← Orders</a><div class="order-detail-hero panel my-4"><div class="toolbar"><div><span class="eyebrow">Order operations</span><h1 class="section-title mt-2">Order #@Model.Id</h1><p class="muted mb-0">Placed @Model.OrderDate.ToLocalTime().ToString("f")</p></div><span class="status-badge @statusClass">@Model.Status</span></div></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h2 class="h5">Items</h2>@foreach(var item in Model.OrderItems){<div class="inventory-row"><span>@item.ProductName × @item.Quantity</span><strong>$@((item.UnitPrice*item.Quantity).ToString("0.00"))</strong></div>}<hr/><div class="d-flex justify-content-between"><strong>Total</strong><strong>$@Model.TotalPrice.ToString("0.00")</strong></div></div></div><div class="col-lg-5"><div class="panel mb-4"><h2 class="h5">Delivery snapshot</h2><p class="mb-1"><strong>@Model.ShippingName</strong></p><p class="muted mb-1">@Model.ShippingEmail · @Model.ShippingPhone</p><p class="muted mb-0">@Model.ShippingAddress</p></div><div class="panel"><h2 class="h5">Timeline</h2>@foreach(var history in Model.StatusHistory){<div class="inventory-row"><div><strong>@history.Status</strong><span>@history.Note</span></div><time>@history.CreatedAt.ToLocalTime().ToString("g")</time></div>}</div></div></div></div></section>
