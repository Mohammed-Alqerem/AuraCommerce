@model List<Orders>

@{
    ViewData["Title"] = "Admin Orders";
}

<section class="page-header">
    <div class="container admin-heading">
        <div><span class="eyebrow">Fulfilment queue</span><h1 class="display-title mt-2 mb-2">Orders</h1><p class="muted mb-0">Update each order as it moves through fulfilment.</p></div>
        <span class="admin-summary-pill">@Model.Count orders</span>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <partial name="_AdminNavigation" />
        <div class="panel admin-panel"><div class="table-responsive"><table class="table table-store align-middle admin-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td><strong>@order.User?.Name</strong><div class="muted small">@order.User?.Email</div></td>
                            <td>@order.OrderDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <form class="d-flex gap-2" asp-action="UpdateOrderStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <select class="form-select order-status-select" name="status">
                                        @foreach (var status in OrderStatuses.All)
                                        {
                                            <option value="@status" selected="@(order.Status == status)">@status</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-dark py-1" type="submit">Save</button>
                                </form>
                            </td>
                            <td><strong>$@order.TotalPrice.ToString("0.00")</strong></td>
                            <td><a asp-action="OrderDetails" asp-route-id="@order.Id">Details</a></td>
                        </tr>
                    }
                </tbody>
            </table></div></div>
        </div>
    </div>
</section>
