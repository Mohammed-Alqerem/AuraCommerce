@model ReportsViewModel
@{ ViewData["Title"] = "Sales Reports"; }
<section class="page-header"><div class="container">@await Html.PartialAsync("_AdminNavigation")<span class="eyebrow">Store intelligence</span><h1 class="display-title mt-2 mb-0">Sales reports</h1></div></section>
<section class="page-section"><div class="container"><form method="get" class="filter-bar mb-4"><label>From <input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></label><label>To <input class="form-control" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></label><button class="btn btn-accent">Apply</button><a class="btn btn-outline-dark" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Export CSV</a></form><div class="stats-grid mb-4"><article class="stat-card"><span>Revenue</span><strong>$@Model.Revenue.ToString("0.00")</strong></article><article class="stat-card"><span>Orders</span><strong>@Model.OrderCount</strong></article><article class="stat-card"><span>Average order</span><strong>$@Model.AverageOrderValue.ToString("0.00")</strong></article></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h2 class="h4 mb-3">Best sellers</h2><div class="table-responsive"><table class="table table-store"><thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead><tbody>@foreach(var row in Model.BestSellers){<tr><td>@row.Name</td><td>@row.Units</td><td>$@row.Revenue.ToString("0.00")</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="panel"><h2 class="h4 mb-3">By category</h2>@foreach(var row in Model.CategorySales){<div class="inventory-row"><div><strong>@row.Name</strong><span>@row.Units units</span></div><strong>$@row.Revenue.ToString("0.00")</strong></div>}</div></div></div></div></section>
