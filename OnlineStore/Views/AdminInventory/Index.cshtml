@model InventoryViewModel
@{ ViewData["Title"] = "Inventory"; }
<section class="page-header"><div class="container">@await Html.PartialAsync("_AdminNavigation")<span class="eyebrow">Stock control</span><h1 class="display-title mt-2 mb-2">Inventory</h1><p class="muted mb-0">@Model.TotalItems matching products.</p></div></section>
<section class="page-section"><div class="container"><form method="get" class="filter-bar mb-4"><input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Search name or SKU"/><select class="form-select" name="stockState" aria-label="Stock state"><option value="all" selected="@(Model.StockState=="all")">All stock</option><option value="low" selected="@(Model.StockState=="low")">Low stock</option><option value="out" selected="@(Model.StockState=="out")">Out of stock</option><option value="healthy" selected="@(Model.StockState=="healthy")">Healthy</option></select><button class="btn btn-accent">Apply</button></form><div class="panel table-responsive"><table class="table table-store"><thead><tr><th>Product</th><th>SKU</th><th>Stock</th><th>Threshold</th><th>Adjustment</th><th>History</th></tr></thead><tbody>@foreach(var product in Model.Products){<tr><td><strong>@product.Name</strong></td><td>@(string.IsNullOrEmpty(product.Sku)?"—":product.Sku)</td><td>@product.Stock</td><td>@product.LowStockThreshold</td><td><form asp-action="Adjust" method="post" class="d-flex gap-2"><input type="hidden" name="ProductId" value="@product.Id"/><input class="form-control" name="QuantityChange" type="number" aria-label="Quantity change" style="max-width:90px"/><input class="form-control" name="Reason" maxlength="160" placeholder="Reason"/><button class="btn btn-outline-dark" type="submit">Adjust</button></form></td><td><a asp-action="History" asp-route-productId="@product.Id">View</a></td></tr>}</tbody></table></div></div></section>
