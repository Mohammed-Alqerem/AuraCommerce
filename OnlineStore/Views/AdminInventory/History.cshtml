@model List<InventoryAdjustment>
@{ ViewData["Title"] = "Stock History"; var product=(Products)ViewBag.Product; }
<section class="page-section"><div class="container"><a class="back-link" asp-action="Index">← Inventory</a><h1 class="section-title my-4">@product.Name stock history</h1><div class="panel table-responsive"><table class="table table-store"><thead><tr><th>Date</th><th>Change</th><th>Stock after</th><th>Reason</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedAt.ToLocalTime().ToString("g")</td><td>@(item.QuantityChange>0?"+":"")@item.QuantityChange</td><td>@item.StockAfter</td><td>@item.Reason</td></tr>}</tbody></table></div></div></section>
