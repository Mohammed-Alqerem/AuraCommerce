@model List<Reviews>
@{ ViewData["Title"] = "Review Moderation"; }
<section class="page-header"><div class="container">@await Html.PartialAsync("_AdminNavigation")<span class="eyebrow">Customer feedback</span><h1 class="display-title mt-2 mb-0">Review moderation</h1></div></section>
<section class="page-section"><div class="container"><div class="panel table-responsive"><table class="table table-store"><thead><tr><th>Date</th><th>Product</th><th>Customer</th><th>Rating</th><th>Comment</th><th>Visibility</th></tr></thead><tbody>@foreach(var review in Model){<tr><td>@review.CreatedAt.ToLocalTime().ToString("d")</td><td>@review.Product?.Name</td><td>@review.User?.Name</td><td>@review.Rating / 5</td><td>@review.Comment</td><td><form asp-action="Toggle" asp-route-id="@review.Id" method="post"><button class="btn @(review.IsVisible?"btn-outline-danger":"btn-outline-success") py-1" type="submit">@(review.IsVisible?"Hide":"Restore")</button></form></td></tr>}</tbody></table></div></div></section>
