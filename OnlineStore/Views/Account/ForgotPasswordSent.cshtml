@{ ViewData["Title"]="Check Your Email"; }
<section class="success-page"><div class="container"><div class="success-card mx-auto" style="max-width:620px"><span class="success-icon"><span class="material-symbols-outlined">mark_email_read</span></span><h1 class="section-title">Check your email</h1><p class="muted">If an account matches that address, a password reset link has been prepared.</p>@if(TempData["DevelopmentResetLink"] is string link){<div class="alert alert-warning"><strong>Development only:</strong> email delivery is not configured. <a href="@link">Open the reset link</a>.</div>}<a class="btn btn-outline-dark" asp-action="Login">Back to login</a></div></div></section>
