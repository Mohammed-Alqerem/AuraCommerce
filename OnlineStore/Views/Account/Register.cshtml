@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-page">
    <div class="auth-shell auth-shell-register">
        <div class="auth-media">
            <img src="https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&fit=crop&w=1200&q=80" alt="Online checkout" />
            <div class="auth-media-content">
                <span class="eyebrow" data-i18n="register.mediaEyebrow">Create your store account</span>
                <h2 data-i18n="register.mediaTitle">Save your details, track orders, and checkout faster every time.</h2>
                <div class="auth-feature-row">
                    <span><span class="material-symbols-outlined">local_shipping</span><span data-i18n="register.featureOrders">Order tracking</span></span>
                    <span><span class="material-symbols-outlined">shopping_bag</span><span data-i18n="register.featureCart">Personal cart</span></span>
                </div>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-card-actions">
                <button class="icon-button js-theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
                    <span class="material-symbols-outlined">dark_mode</span>
                </button>
                <button class="language-button js-language-toggle" type="button" aria-label="Switch language">AR</button>
            </div>

            <span class="eyebrow" data-i18n="register.eyebrow">New Customer</span>
            <h1 class="section-title mt-2 mb-2" data-i18n="register.title">Create Account</h1>
            <p class="muted mb-4" data-i18n="register.subtitle">Register once and use the same account for cart, checkout, profile, and orders.</p>

            <form asp-action="Register" method="post" class="auth-form row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold" data-i18n="register.name">Name</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">person</span>
                        <input asp-for="Name" class="form-control" data-i18n-placeholder="register.namePlaceholder" placeholder="Full name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold" data-i18n="login.email">Email</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">mail</span>
                        <input asp-for="Email" class="form-control" data-i18n-placeholder="login.emailPlaceholder" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-bold" data-i18n="login.password">Password</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">lock</span>
                        <input asp-for="Password" type="password" class="form-control" data-i18n-placeholder="login.passwordPlaceholder" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm password</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">lock_reset</span>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold" data-i18n="register.phone">Phone</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">call</span>
                        <input asp-for="Phone" class="form-control" data-i18n-placeholder="register.phonePlaceholder" placeholder="Phone number" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label fw-bold" data-i18n="register.address">Address</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">location_on</span>
                        <input asp-for="Address" class="form-control" data-i18n-placeholder="register.addressPlaceholder" placeholder="Delivery address" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button class="btn btn-accent" type="submit" data-i18n="register.submit">Create Account</button>
                    <a class="btn btn-outline-dark" asp-action="Login" data-i18n="nav.login">Login</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
