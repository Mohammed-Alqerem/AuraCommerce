@model ForgotPasswordViewModel
@{ ViewData["Title"]="Forgot Password"; }
<section class="page-section"><div class="container" style="max-width:560px"><div class="panel"><span class="eyebrow">Account recovery</span><h1 class="section-title my-3">Reset your password</h1><p class="muted">Enter your account email. If it exists, we’ll send a one-hour reset link.</p><form asp-action="ForgotPassword" method="post" novalidate><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-2" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span><button class="btn btn-accent w-100 mt-3" type="submit">Send reset link</button></form></div></div></section>
