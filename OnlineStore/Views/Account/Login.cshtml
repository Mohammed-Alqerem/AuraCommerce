@model LoginViewModel
@inject OnlineStore.Services.ExternalProviderAvailability ExternalProviders

@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">
    <div class="auth-shell">
        <div class="auth-media">
            <img src="https://images.unsplash.com/photo-1607082349566-187342175e2f?auto=format&fit=crop&w=1200&q=80" alt="Shopping bags" />
            <div class="auth-media-content">
                <span class="eyebrow" data-i18n="login.mediaEyebrow">Secure Storefront</span>
                <h2 data-i18n="login.mediaTitle">Manage carts, orders, and products from one modern MVC platform.</h2>
                <div class="auth-feature-row">
                    <span><span class="material-symbols-outlined">verified_user</span><span data-i18n="login.featureSecure">Secure session</span></span>
                    <span><span class="material-symbols-outlined">language</span><span data-i18n="login.featureLanguage">Arabic / English</span></span>
                </div>
            </div>
        </div>
        <div class="auth-card">
            <div class="auth-card-actions">
                <button class="icon-button js-theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
                    <span class="material-symbols-outlined">dark_mode</span>
                </button>
                <button class="language-button js-language-toggle" type="button" aria-label="Switch language">AR</button>
            </div>

            <span class="eyebrow" data-i18n="login.eyebrow">Account Access</span>
            <h1 class="section-title mt-2 mb-2" data-i18n="login.title">Welcome Back</h1>
            <p class="muted mb-4" data-i18n="login.subtitle">Sign in to continue to your account.</p>

            @if (TempData["ExternalLoginMessage"] is string externalLoginMessage)
            {
                <div class="auth-status" role="status">
                    <span class="material-symbols-outlined" aria-hidden="true">info</span>
                    <span>@externalLoginMessage</span>
                </div>
            }

            <div class="external-auth">
                <form asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <button class="external-auth-button external-auth-button-google" type="submit" disabled="@(!ExternalProviders.Google)">
                        <svg class="external-auth-logo" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.41Z" />
                            <path fill="#34A853" d="M12 22c2.7 0 4.98-.9 6.63-2.36l-3.24-2.54c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22Z" />
                            <path fill="#FBBC05" d="M6.39 13.93A6.02 6.02 0 0 1 6.07 12c0-.67.12-1.32.32-1.93V7.45H3.04A10 10 0 0 0 2 12c0 1.61.39 3.14 1.04 4.55l3.35-2.62Z" />
                            <path fill="#EA4335" d="M12 5.94c1.47 0 2.78.5 3.82 1.49l2.87-2.87A9.64 9.64 0 0 0 12 2a10 10 0 0 0-8.96 5.45l3.35 2.62C7.18 7.7 9.39 5.94 12 5.94Z" />
                        </svg>
                        <span data-i18n="login.continueGoogle">Continue with Google</span>
                    </button>
                </form>

                <form asp-action="ExternalLogin" asp-route-provider="Apple" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <button class="external-auth-button external-auth-button-apple" type="submit" disabled="@(!ExternalProviders.Apple)">
                        <svg class="external-auth-logo" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M17.05 12.54c-.03-3.02 2.47-4.49 2.58-4.56a5.5 5.5 0 0 0-4.33-2.34c-1.82-.19-3.59 1.09-4.52 1.09-.95 0-2.39-1.07-3.94-1.04a5.75 5.75 0 0 0-4.84 2.95c-2.1 3.64-.53 8.98 1.48 11.92 1 1.44 2.17 3.05 3.72 3 1.52-.06 2.08-.96 3.91-.96 1.81 0 2.34.96 3.92.93 1.63-.03 2.66-1.45 3.62-2.9a11.9 11.9 0 0 0 1.66-3.38 5.22 5.22 0 0 1-3.26-4.71ZM14.11 3.71A5.3 5.3 0 0 0 15.32 0a5.4 5.4 0 0 0-3.49 1.76 5.05 5.05 0 0 0-1.24 3.57 4.46 4.46 0 0 0 3.52-1.62Z" />
                        </svg>
                        <span data-i18n="login.continueApple">Continue with Apple</span>
                    </button>
                </form>
            </div>

            @if (!ExternalProviders.Google || !ExternalProviders.Apple)
            {
                <p class="external-auth-note" data-i18n="login.externalUnavailable">Unavailable options activate after secure provider setup.</p>
            }

            <div class="auth-divider" role="separator">
                <span data-i18n="login.continueEmail">or continue with email</span>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="auth-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold" data-i18n="login.email">Email</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">mail</span>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" data-i18n-placeholder="login.emailPlaceholder" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-bold" data-i18n="login.password">Password</label>
                    <div class="input-with-icon">
                        <span class="material-symbols-outlined">lock</span>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" data-i18n-placeholder="login.passwordPlaceholder" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="text-end mb-4"><a asp-action="ForgotPassword" data-i18n="login.forgot">Forgot password?</a></div>

                <button class="btn btn-accent w-100" type="submit" data-i18n="login.submit">Login</button>
            </form>

            <p class="text-center muted mt-4 mb-0">
                <span data-i18n="login.noAccount">No account?</span>
                <a asp-action="Register" data-i18n="login.register">Register</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
