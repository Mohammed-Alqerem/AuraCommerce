@model ResetPasswordViewModel
@{ ViewData["Title"]="Reset Password"; }
<section class="page-section"><div class="container" style="max-width:560px"><div class="panel"><h1 class="section-title mb-4">Choose a new password</h1><form asp-action="ResetPassword" method="post" novalidate><input asp-for="Token" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-accent w-100" type="submit">Reset password</button></form></div></div></section>
