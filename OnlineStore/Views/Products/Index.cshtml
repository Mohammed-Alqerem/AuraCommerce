@model ProductCatalogViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">Catalog</span>
        <h1 class="display-title mt-2 mb-3">@Model.Title</h1>
        <p class="muted mb-0">Search, filter, inspect details, add items to cart, and review products from the database.</p>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <div class="toolbar mb-3">
            <div class="filter-bar">
                <a class="filter-chip @(Model.CategoryId == null ? "active" : "")" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm">All</a>
                @foreach (var category in Model.Categories)
                {
                    <a class="filter-chip @(Model.CategoryId == category.Id ? "active" : "")" asp-action="Index" asp-route-categoryId="@category.Id" asp-route-searchTerm="@Model.SearchTerm">@category.Name</a>
                }
            </div>
        </div>
        <form class="panel row g-3 align-items-end mb-4" asp-action="Index" method="get">
                @if (Model.CategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                }
                <div class="col-lg-3"><label class="form-label" for="catalog-search">Search</label><input id="catalog-search" class="form-control" name="searchTerm" type="search" value="@Model.SearchTerm" placeholder="Name, brand, or category" /></div>
                <div class="col-6 col-lg-2"><label class="form-label" for="min-price">Minimum price</label><input id="min-price" class="form-control" name="minPrice" type="number" min="0" step="0.01" value="@Model.MinPrice" /></div>
                <div class="col-6 col-lg-2"><label class="form-label" for="max-price">Maximum price</label><input id="max-price" class="form-control" name="maxPrice" type="number" min="0" step="0.01" value="@Model.MaxPrice" /></div>
                <div class="col-6 col-lg-2"><label class="form-label" for="rating">Rating</label><select id="rating" class="form-select" name="minimumRating"><option value="">Any rating</option>@for(var rating=4;rating>=1;rating--){<option value="@rating" selected="@(Model.MinimumRating==rating)">@rating+ stars</option>}</select></div>
                <div class="col-6 col-lg-2"><label class="form-label" for="sort">Sort</label><select id="sort" class="form-select" name="sort"><option value="name" selected="@(Model.Sort=="name")">Name</option><option value="price-asc" selected="@(Model.Sort=="price-asc")">Price: low to high</option><option value="price-desc" selected="@(Model.Sort=="price-desc")">Price: high to low</option><option value="rating" selected="@(Model.Sort=="rating")">Top rated</option><option value="newest" selected="@(Model.Sort=="newest")">Newest</option></select></div>
                <div class="col-lg-3 form-check ms-2"><input id="in-stock" class="form-check-input" name="inStockOnly" type="checkbox" value="true" checked="@Model.InStockOnly"/><label class="form-check-label" for="in-stock">In stock only</label></div>
                <div class="col-lg-auto"><button class="btn btn-accent" type="submit">Apply filters</button></div><div class="col-lg-auto"><a class="btn btn-outline-dark" asp-action="Index">Clear</a></div>
        </form>

        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <h2 class="section-title">No products found</h2>
                <p class="muted">Try another search or category.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    var averageRating = product.Reviews != null && product.Reviews.Any() ? product.Reviews.Average(review => review.Rating) : 0;
                    <article class="product-card">
                        <a asp-action="Details" asp-route-id="@product.Id">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                        </a>
                        <div class="product-card-body">
                            <span class="category-pill">@product.Category?.Name</span>
                            <h3 class="product-title"><a asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h3>
                            <p class="muted mb-0">@product.Description</p>
                            <div><span class="rating">*****</span> <span class="muted small">@averageRating.ToString("0.0") (@(product.Reviews?.Count ?? 0))</span></div>
                            <div class="d-flex align-items-center justify-content-between mt-auto">
                                <span class="price">$@product.Price.ToString("0.00")</span>
                                <div class="d-flex gap-2"><form asp-controller="Wishlist" asp-action="Toggle" method="post"><input type="hidden" name="productId" value="@product.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><button class="icon-button" type="submit" aria-label="@(Model.SavedProductIds.Contains(product.Id) ? "Remove from wishlist" : "Save to wishlist")"><span class="material-symbols-outlined">@(Model.SavedProductIds.Contains(product.Id) ? "favorite" : "favorite_border")</span></button></form><form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button class="icon-button" type="submit" aria-label="Add @product.Name to cart">
                                        <span class="material-symbols-outlined">add_shopping_cart</span>
                                    </button>
                                </form></div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Product pages">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RouteValues(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteValues(pageNumber)">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RouteValues(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

@functions {
    Dictionary<string, string> RouteValues(int page) => new()
    {
        ["searchTerm"] = Model.SearchTerm ?? "", ["categoryId"] = Model.CategoryId?.ToString() ?? "",
        ["minPrice"] = Model.MinPrice?.ToString() ?? "", ["maxPrice"] = Model.MaxPrice?.ToString() ?? "",
        ["inStockOnly"] = Model.InStockOnly.ToString(), ["minimumRating"] = Model.MinimumRating?.ToString() ?? "",
        ["sort"] = Model.Sort, ["page"] = page.ToString()
    };
}
