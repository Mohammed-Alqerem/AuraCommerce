@model Orders

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var statusClass = $"status-{Model.Status.ToLower()}";
}

<section class="page-section">
    <div class="container">
        <a asp-action="Index" class="back-link d-inline-flex align-items-center gap-1 mb-4">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to orders
        </a>
        <div class="panel order-detail-hero mb-4">
            <div class="toolbar">
                <div>
                    <span class="eyebrow">Order Details</span>
                    <h1 class="section-title mb-1">Order #@Model.Id</h1>
                    <p class="muted mb-0">@Model.OrderDate.ToString("MMM d, yyyy") - @Model.User?.Name</p>
                </div>
                <span class="status-badge @statusClass">@Model.Status</span>
            </div>
        </div>
        <div class="row g-4"><div class="col-lg-8"><div class="panel order-items-panel">
            <table class="table table-store align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>$@item.UnitPrice.ToString("0.00")</td>
                            <td><strong>$@((item.UnitPrice * item.Quantity).ToString("0.00"))</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
            <hr />
            <div class="d-flex justify-content-end fs-4"><span class="me-3">Total</span><strong>$@Model.TotalPrice.ToString("0.00")</strong></div>
        </div></div><aside class="col-lg-4"><div class="panel mb-4"><h2 class="h5">Delivery details</h2><p class="mb-1"><strong>@Model.ShippingName</strong></p><p class="muted mb-1">@Model.ShippingEmail · @Model.ShippingPhone</p><p class="muted mb-0">@Model.ShippingAddress</p></div><div class="panel"><h2 class="h5">Tracking timeline</h2>@if(!Model.StatusHistory.Any()){<p class="muted mb-0">The first tracking update will appear here.</p>}else{foreach(var history in Model.StatusHistory){<div class="inventory-row"><div><strong>@history.Status</strong><span>@history.Note</span></div><time>@history.CreatedAt.ToLocalTime().ToString("g")</time></div>}}</div></aside></div>
    </div>
</section>
