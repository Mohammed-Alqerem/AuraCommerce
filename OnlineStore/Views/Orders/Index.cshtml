@model List<Orders>

@{
    ViewData["Title"] = "My Orders";
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">Account</span>
        <h1 class="display-title mt-2 mb-0">My Orders</h1>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <div class="panel">
            <table class="table table-store align-middle">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var statusClass = $"status-{order.Status.ToLower()}";
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.OrderDate.ToString("MMM d, yyyy")</td>
                            <td>@(order.OrderItems?.Sum(item => item.Quantity) ?? 0)</td>
                            <td><span class="status-badge @statusClass">@order.Status</span></td>
                            <td><strong>$@order.TotalPrice.ToString("0.00")</strong></td>
                            <td><a asp-action="Details" asp-route-id="@order.Id">Details</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
