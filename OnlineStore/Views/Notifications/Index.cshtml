@model List<StoreNotification>
@{ ViewData["Title"]="Notifications"; }
<section class="page-header"><div class="container"><span class="eyebrow">Account updates</span><h1 class="display-title mt-2 mb-0">Notifications</h1></div></section><section class="page-section"><div class="container" style="max-width:850px">@if(!Model.Any()){<div class="empty-state"><h2 class="section-title">You’re all caught up</h2><p class="muted">Order and account updates will appear here.</p></div>}else{@foreach(var item in Model){<article class="panel mb-3 @(item.IsRead?"":"border-primary")"><div class="toolbar"><div><h2 class="h5 mb-1">@item.Title</h2><p class="muted mb-1">@item.Message</p><small class="muted">@item.CreatedAt.ToLocalTime().ToString("g")</small></div>@if(!item.IsRead){<form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-outline-dark" type="submit">Open</button></form>}</div></article>}}</div></section>
